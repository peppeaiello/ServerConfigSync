<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs the game-independent logic against the real BepInEx ConfigFile: dotnet run, from the tests/ServerConfigSync.Tests folder -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <ValheimDir Condition="'$(ValheimDir)' == ''">/DATA/AppData/valheim-gale/server</ValheimDir>
    <ValheimManaged Condition="Exists('$(ValheimDir)/valheim_server_Data/Managed')">$(ValheimDir)/valheim_server_Data/Managed</ValheimManaged>
    <ValheimManaged Condition="'$(ValheimManaged)' == ''">$(ValheimDir)/valheim_Data/Managed</ValheimManaged>
  </PropertyGroup>

  <ItemGroup>
    <!-- The 0Harmony.dll shipped with BepInEx does not run on modern .NET; same API, newer build. -->
    <PackageReference Include="HarmonyX" Version="2.16.1" />
    <ProjectReference Include="../../src/ServerConfigSync/ServerConfigSync.csproj" />
    <Reference Include="BepInEx" HintPath="$(ValheimDir)/BepInEx/core/BepInEx.dll" />
    <Reference Include="assembly_valheim" HintPath="$(ValheimManaged)/assembly_valheim.dll" />
    <Reference Include="UnityEngine" HintPath="$(ValheimManaged)/UnityEngine.dll" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ValheimManaged)/UnityEngine.CoreModule.dll" />
  </ItemGroup>

</Project>
